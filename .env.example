# Copy to .env on the server and fill in the secrets. Never commit .env.
# API keys for OpenAI, GitHub, Telegram, and LinkedIn are stored as n8n credentials, not here.

N8N_HOST=n8n.all-maker.com
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.all-maker.com/
GENERIC_TIMEZONE=Europe/Amsterdam
TZ=Europe/Amsterdam

# Generate each with: openssl rand -hex 32
# Store N8N_ENCRYPTION_KEY in a password manager. Losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=
QDRANT_API_KEY=
