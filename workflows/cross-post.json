    {
      "parameters": {
        "jsCode": "// One run = one new blog post. A push that adds several posts handles the first; run the others manually.\nconst input = $input.first().json;\nlet paths = [];\nlet manual = false;\nif (input.body) {\n  const body = input.body;\n  if (body.ref !== 'refs/heads/master' || body.deleted) return [];\n  const added = new Set();\n  for (const commit of body.commits || []) {\n    for (const p of commit.added || []) added.add(p);\n    for (const p of commit.removed || []) added.delete(p);\n  }\n  paths = [...added].filter((p) => /^blog\\/.+\\.mdx?$/.test(p)).sort();\n} else {\n  manual = true;\n  paths = [String(input.path || '').trim()].filter(Boolean);\n}\nif (!paths.length) return [];\nreturn [{ json: { path: paths[0], others: paths.slice(1), manual } }];\n"
      },
      "id": "28edc72e-0457-42a9-9111-e9ba78eb8d77",
