    {
      "parameters": {
        "jsCode": "// Build the Bluesky record: the title in the closing line links to the post, other URLs are clickable, plus a link card.\nconst p = $('Prepare post').first().json;\nconst s = $('Bluesky session').first().json;\nconst text = p.drafts.bluesky;\nconst bytes = (str) => encodeURIComponent(str).replace(/%[0-9A-F]{2}/g, 'x').length;\nconst facets = [];\nfor (const m of text.matchAll(/https?:\\/\\/[^\\s<>\"')\\]]+/g)) {\n  const uri = m[0].replace(/[.,;:!?]+$/, '');\n  const byteStart = bytes(text.slice(0, m.index));\n  facets.push({ index: { byteStart, byteEnd: byteStart + bytes(uri) }, features: [{ $type: 'app.bsky.richtext.facet#link', uri }] });\n}\nconst titleEnd = bytes(text);\nfacets.push({ index: { byteStart: titleEnd - bytes(p.title), byteEnd: titleEnd }, features: [{ $type: 'app.bsky.richtext.facet#link', uri: p.url }] });\nreturn [{ json: {\n  repo: s.did,\n  collection: 'app.bsky.feed.post',\n  record: {\n    $type: 'app.bsky.feed.post',\n    text,\n    createdAt: new Date().toISOString(),\n    langs: ['en'],\n    facets,\n    embed: { $type: 'app.bsky.embed.external', external: { uri: p.url, title: p.title, description: p.description } },\n  },\n} }];\n"
      },
