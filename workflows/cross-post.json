    {
      "parameters": {
        "jsCode": "// Read the post, build its public URL, and turn the one social text into a post per platform.\nconst YAML = require('yaml');\nconst f = $('Find new post').first().json;\nconst raw = $json.data;\nif (typeof raw !== 'string') throw new Error(`Could not fetch ${f.path} from GitHub.`);\nconst m = raw.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\nconst fm = m ? YAML.parse(m[1]) || {} : {};\nif (fm.draft === true || fm.unlisted === true) return [];\n\nconst file = f.path.split('/').pop().replace(/\\.mdx?$/, '');\nconst dated = file.match(/^(\\d{4})-(\\d{2})-(\\d{2})-(.+)$/);\nconst url = fm.slug\n  ? `https://all-maker.com/blog/${String(fm.slug).replace(/^\\//, '')}`\n  : dated ? `https://all-maker.com/blog/${dated[1]}/${dated[2]}/${dated[3]}/${dated[4]}` : `https://all-maker.com/blog/${file}`;\nconst title = fm.title || file;\nconst social = typeof (fm.context || {}).social === 'string' ? fm.context.social.trim() : '';\n\n// One text for every platform, sized for the strictest limit: Bluesky, 300 characters with the closing line.\n// Bluesky links the title, LinkedIn shows a link card, Mastodon needs the URL in the text.\nconst graphemes = (s) => (typeof Intl !== 'undefined' && Intl.Segmenter)\n  ? [...new Intl.Segmenter('en', { granularity: 'grapheme' }).segment(s)].length : [...s].length;\nconst closing = `\\n\\nFull post: ${title}`;\nconst budget = 300 - graphemes(closing);\nconst drafts = {};\nconst problems = [];\nif (social && graphemes(social) > budget) {\n  problems.push(`\\`context.social\\` has ${graphemes(social)} characters. With this title the limit is ${budget}. Shorten it by ${graphemes(social) - budget}. Nothing was posted.`);\n} else if (social) {\n  drafts.linkedin = social + closing;\n  drafts.bluesky = social + closing;\n  drafts.mastodon = social + closing + `\\n${url}`;\n}\n\nreturn [{ json: {\n  path: f.path, others: f.others, manual: f.manual, title, description: fm.description || '', url,\n  github_url: `https://github.com/strahinjamilosevic/all-maker/blob/master/${f.path}`,\n  hn_url: `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}`,\n  drafts, problems, has_drafts: Object.keys(drafts).length > 0,\n} }];\n"
      },
