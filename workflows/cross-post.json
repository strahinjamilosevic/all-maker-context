    {
      "parameters": {
        "jsCode": "// Collect the outcome per platform. Error text is limited to message and description: the Issue is public.\nconst p = $('Prepare post').first().json;\nconst ran = (n) => { try { return $(n).isExecuted; } catch (e) { return false; } };\nconst out = (n) => (ran(n) ? $(n).first().json : null);\nconst errorText = (j) => {\n  if (!j || !j.error) return null;\n  const e = j.error;\n  return (typeof e === 'string' ? e : [e.message, e.description].filter(Boolean).join(': ') || 'Unknown error').slice(0, 500);\n};\nconst PLATFORMS = [\n  { key: 'linkedin', name: 'LinkedIn', approve: 'Approve LinkedIn', steps: ['Post to LinkedIn'] },\n  { key: 'bluesky', name: 'Bluesky', approve: 'Approve Bluesky', steps: ['Bluesky session', 'Post to Bluesky'] },\n  { key: 'mastodon', name: 'Mastodon', approve: 'Approve Mastodon', steps: ['Post to Mastodon'] },\n];\nconst lines = [];\nconst failures = [...p.problems];\nfor (const pl of PLATFORMS) {\n  if (!p.drafts[pl.key]) { lines.push(`${pl.name}: skipped, no draft`); continue; }\n  if (!(out(pl.approve) || {}).data?.approved) { lines.push(`${pl.name}: not approved`); continue; }\n  const err = pl.steps.map((n) => errorText(out(n))).find(Boolean);\n  if (err) { lines.push(`${pl.name}: FAILED`); failures.push(`${pl.name}: ${err}`); continue; }\n  let link = '';\n  if (pl.key === 'bluesky') {\n    const uri = (out('Post to Bluesky') || {}).uri || '';\n    const handle = (out('Bluesky session') || {}).handle;\n    if (uri && handle) link = ` https://bsky.app/profile/${handle}/post/${uri.split('/').pop()}`;\n  }\n  if (pl.key === 'mastodon' && (out('Post to Mastodon') || {}).url) link = ` ${out('Post to Mastodon').url}`;\n  lines.push(`${pl.name}: posted${link}`);\n}\nreturn [{ json: { summary: lines.join('\\n'), failures, has_failures: failures.length > 0 } }];\n"
      },
