    {
      "parameters": {
        "jsCode": "// One line for the reply or like, with a link to the new reply where the API returns one.\nconst ran = (n) => { try { return $(n).isExecuted; } catch (e) { return false; } };\nconst out = (n) => (ran(n) ? $(n).first().json : null);\nconst errorText = (j) => {\n  if (!j || !j.error) return null;\n  const e = j.error;\n  return (typeof e === 'string' ? e : [e.message, e.description].filter(Boolean).join(': ') || 'Unknown error').slice(0, 500);\n};\nconst r = $('Route').first().json;\nconst steps = r.platform === 'Bluesky'\n  ? ['Bluesky session (engage)', 'Get target post', 'Build Bluesky action', 'Bluesky create (engage)']\n  : ['Mastodon action'];\nconst what = r.action === 'like' ? 'like' : 'reply';\nconst err = steps.filter(ran).map((n) => errorText(out(n))).find(Boolean);\nif (err) return [{ json: { summary: `${r.platform} ${what}: FAILED: ${err}` } }];\nlet link = '';\nif (what === 'reply' && r.platform === 'Bluesky') {\n  const uri = (out('Bluesky create (engage)') || {}).uri || '';\n  const handle = (out('Bluesky session (engage)') || {}).handle;\n  if (uri && handle) link = ` https://bsky.app/profile/${handle}/post/${uri.split('/').pop()}`;\n}\nif (what === 'reply' && r.platform === 'Mastodon' && (out('Mastodon action') || {}).url) link = ` ${out('Mastodon action').url}`;\nreturn [{ json: { summary: `${what === 'like' ? 'Liked' : 'Replied'} on ${r.platform}.${link}` } }];\n"
      },
