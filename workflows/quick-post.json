    {
      "parameters": {
        "jsCode": "// Collect the outcome per platform, with a link to each new post where the API returns one.\nconst ran = (n) => { try { return $(n).isExecuted; } catch (e) { return false; } };\nconst out = (n) => (ran(n) ? $(n).first().json : null);\nconst errorText = (j) => {\n  if (!j || !j.error) return null;\n  const e = j.error;\n  return (typeof e === 'string' ? e : [e.message, e.description].filter(Boolean).join(': ') || 'Unknown error').slice(0, 500);\n};\nconst PLATFORMS = [\n  { name: 'LinkedIn', steps: ['Post to LinkedIn (link)', 'Post to LinkedIn (text)'] },\n  { name: 'Bluesky', steps: ['Bluesky session', 'Post to Bluesky'] },\n  { name: 'Mastodon', steps: ['Post to Mastodon'] },\n];\nconst lines = [];\nfor (const pl of PLATFORMS) {\n  const err = pl.steps.filter(ran).map((n) => errorText(out(n))).find(Boolean);\n  if (err) { lines.push(`${pl.name}: FAILED: ${err}`); continue; }\n  let link = '';\n  if (pl.name === 'Bluesky') {\n    const uri = (out('Post to Bluesky') || {}).uri || '';\n    const handle = (out('Bluesky session') || {}).handle;\n    if (uri && handle) link = ` https://bsky.app/profile/${handle}/post/${uri.split('/').pop()}`;\n  }\n  if (pl.name === 'Mastodon' && (out('Post to Mastodon') || {}).url) link = ` ${out('Post to Mastodon').url}`;\n  lines.push(`${pl.name}: posted${link}`);\n}\nreturn [{ json: { summary: lines.join('\\n') } }];\n"
      },
