    {
      "parameters": {
        "jsCode": "// Title and description for the link card, from the page's Open Graph tags.\n// A page that cannot be fetched still gets a card, with the URL as title.\nconst p = $('Route').first().json;\nif (!p.url) return [{ json: { url: '', title: '', description: '' } }];\nlet html = '';\ntry {\n  if ($('Fetch page').isExecuted) html = String($('Fetch page').first().json.data || '');\n} catch (e) {}\nconst decode = (s) => s\n  .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))\n  .replace(/&#(\\d+);/g, (_, d) => String.fromCodePoint(Number(d)))\n  .replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')\n  .replace(/\\s+/g, ' ').trim();\nconst attr = (tag, name) => {\n  const m = tag.match(new RegExp(`\\\\b${name}\\\\s*=\\\\s*(?:\"([^\"]*)\"|'([^']*)')`, 'i'));\n  return m ? (m[1] ?? m[2]) : '';\n};\nconst metas = html.match(/<meta\\b[^>]*>/gi) || [];\nconst meta = (key) => {\n  for (const t of metas) {\n    if ((attr(t, 'property') || attr(t, 'name')).toLowerCase() === key) return decode(attr(t, 'content'));\n  }\n  return '';\n};\nconst titleTag = decode((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '');\nreturn [{ json: {\n  url: p.url,\n  title: (meta('og:title') || meta('twitter:title') || titleTag || p.url).slice(0, 300),\n  description: (meta('og:description') || meta('twitter:description') || meta('description')).slice(0, 1000),\n} }];\n"
      },
