    {
      "parameters": {
        "jsCode": "// One Telegram update in, one action out:\n// draft (preview a new post), post (Post tapped), reply_draft (preview a reply to a notification),\n// reply (Send reply tapped), like (Like tapped on a notification), say (answer only).\n// Only the owner's updates count. Previews and notifications carry their text and target link, so nothing is stored.\nconst OWNER = 8199050777;\nconst u = $json;\nconst cq = u.callback_query;\nconst msg = cq ? cq.message : u.message;\nconst from = cq ? cq.from : (u.message || {}).from;\nif (!from || from.id !== OWNER || !msg) return [];\nconst chat_id = msg.chat.id;\n\nconst graphemes = (s) => (typeof Intl !== 'undefined' && Intl.Segmenter)\n  ? [...new Intl.Segmenter('en', { granularity: 'grapheme' }).segment(s)].length : [...s].length;\nconst bytes = (str) => encodeURIComponent(str).replace(/%[0-9A-F]{2}/g, 'x').length;\nconst esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// One text for the given platforms. Bluesky shows each URL shortened and linked, like the Bluesky app does.\n// Mastodon counts every URL as 23 characters; mastodonPrefix is the @mention a Mastodon reply starts with.\nconst LIMITS = { Bluesky: 300, Mastodon: 500, LinkedIn: 3000 };\nconst check = (raw, platforms, mastodonPrefix = '') => {\n  const text = String(raw || '').trim();\n  if (!text) return { error: 'Send the text as a message.' };\n  const urls = [...text.matchAll(/https?:\\/\\/[^\\s<>\"')\\]]+/g)]\n    .map((m) => ({ index: m.index, uri: m[0].replace(/[.,;:!?]+$/, '') }));\n  let btext = '';\n  let pos = 0;\n  const facets = [];\n  for (const { index, uri } of urls) {\n    btext += text.slice(pos, index);\n    let short = uri.replace(/^https?:\\/\\/(www\\.)?/, '');\n    if (short.length > 30) short = short.slice(0, 27) + '...';\n    const byteStart = bytes(btext);\n    btext += short;\n    facets.push({ index: { byteStart, byteEnd: byteStart + bytes(short) }, features: [{ $type: 'app.bsky.richtext.facet#link', uri }] });\n    pos = index + uri.length;\n  }\n  btext += text.slice(pos);\n  const masto = mastodonPrefix + urls.reduce((t, x) => t.replace(x.uri, 'x'.repeat(23)), text);\n  const length = { Bluesky: graphemes(btext), Mastodon: graphemes(masto), LinkedIn: graphemes(text) };\n  const over = platforms.filter((p) => length[p] > LIMITS[p]);\n  if (over.length) {\n    return { error: over.map((p) => `Too long for ${p}: ${length[p]} of ${LIMITS[p]} characters. Shorten by ${length[p] - LIMITS[p]}.`).join('\\n') + '\\nNothing was sent. Send the shorter text again.' };\n  }\n  // The first https link gets a link card.\n  const url = (urls.find((x) => x.uri.startsWith('https://')) || {}).uri || '';\n  return { text, url, bluesky: { text: btext, facets } };\n};\n\n// The target of a notification or reply preview is its \"Open on ...\" / \"Reply on ...\" link.\nconst target = (m) => {\n  for (const e of (m && m.entities) || []) {\n    if (e.type !== 'text_link') continue;\n    let x = e.url.match(/^https:\\/\\/bsky\\.app\\/profile\\/(did:[^/]+)\\/post\\/([^/?#]+)/);\n    if (x) return { platform: 'Bluesky', url: e.url, uri: `at://${x[1]}/app.bsky.feed.post/${x[2]}` };\n    x = e.url.match(/^https:\\/\\/mastodon\\.social\\/@([^/]+)\\/(\\d+)(?:#v=(\\w+))?/);\n    if (x) return { platform: 'Mastodon', url: e.url, acct: x[1], status_id: x[2], visibility: x[3] || 'public' };\n  }\n  return null;\n};\nconst prefixFor = (t) => (t.platform === 'Mastodon' ? `@${t.acct} ` : '');\nconst withPrefix = (t, text) => (t.platform === 'Mastodon' && !text.toLowerCase().startsWith(`@${t.acct}`.toLowerCase()) ? prefixFor(t) + text : text);\nconst say = (reply_to, text, query_id) => [{ json: { action: 'say', chat_id, reply_to, text, query_id: query_id || '' } }];\n\nif (cq) {\n  if (!msg.text) return say(msg.message_id, 'This message is too old or has no text. Send the text again.', cq.id);\n  // A preview or notification button works once: a second tap or a tap after Cancel does nothing.\n  const sd = $getWorkflowStaticData('global');\n  const key = `${chat_id}:${msg.message_id}`;\n  sd.handled = sd.handled || [];\n  if (sd.handled.includes(key)) return say(msg.message_id, 'Already handled.', cq.id);\n  sd.handled = [...sd.handled, key].slice(-500);\n  const base = { chat_id, preview_id: msg.message_id, query_id: cq.id };\n  if (cq.data === 'cancel') return say(msg.message_id, 'Cancelled. Nothing was sent.', cq.id);\n  if (cq.data === 'post') {\n    const c = check(msg.text, ['Bluesky', 'Mastodon', 'LinkedIn']);\n    if (c.error) return say(msg.message_id, c.error, cq.id);\n    return [{ json: { action: 'post', ...base, ...c } }];\n  }\n  if (cq.data === 'reply' || cq.data === 'like') {\n    const t = target(msg);\n    if (!t) return say(msg.message_id, 'No target link found in this message.', cq.id);\n    if (cq.data === 'like') return [{ json: { action: 'like', platform: t.platform, target: t, ...base } }];\n    // Preview layout: \"Reply on <platform>...\" line, blank line, reply text.\n    const body = msg.text.slice(msg.text.indexOf('\\n\\n') + 2);\n    const c = check(body, [t.platform], prefixFor(t));\n    if (c.error) return say(msg.message_id, c.error, cq.id);\n    return [{ json: {\n      action: 'reply', platform: t.platform, target: t, ...base, ...c,\n      mastodon_text: withPrefix(t, c.text),\n      // A Mastodon reply is never more public than the post it answers.\n      mastodon_visibility: t.visibility === 'public' ? 'public' : t.visibility,\n    } }];\n  }\n  return say(msg.message_id, 'Unknown button.', cq.id);\n}\n\nif (msg.text && /^\\/ids\\b/.test(msg.text)) {\n  return say(msg.message_id, `Chat ID: ${chat_id}\\nTopic ID: ${msg.message_thread_id || 'none'}`);\n}\nif (msg.text && msg.text.startsWith('/')) {\n  return say(msg.message_id, 'Send a text to post it on LinkedIn, Bluesky, and Mastodon. You get a preview with a Post button first.\\n\\nReply to a Bluesky or Mastodon notification to answer on that platform.\\n\\nLimit: 300 characters (Bluesky). A link counts as its short form, at most 30 characters. The first https link gets a link card.\\nText only.\\n\\n/ids shows the chat and topic ID.');\n}\nif (msg.photo || msg.video || msg.document || msg.animation || msg.sticker || msg.voice || msg.audio) {\n  return say(msg.message_id, 'Text only. Nothing was sent.');\n}\n\n// A reply to a bot notification answers on that platform. In a forum topic every message replies to the\n// topic's first message, which has no target link, so it falls through to a new post.\nconst parent = msg.reply_to_message;\nconst t = parent && parent.from && parent.from.is_bot ? target(parent) : null;\nif (t) {\n  const c = check(msg.text, [t.platform], prefixFor(t));\n  if (c.error) return say(msg.message_id, c.error);\n  const to = t.platform === 'Mastodon' ? ` to @${t.acct}` : '';\n  return [{ json: { action: 'reply_draft', chat_id, reply_to: msg.message_id, html: `<a href=\"${t.url}\">Reply on ${t.platform}${esc(to)}</a>\\n\\n${esc(withPrefix(t, c.text))}` } }];\n}\n\nconst c = check(msg.text, ['Bluesky', 'Mastodon', 'LinkedIn']);\nif (c.error) return say(msg.message_id, c.error);\nreturn [{ json: { action: 'draft', chat_id, reply_to: msg.message_id, text: c.text } }];\n"
      },
