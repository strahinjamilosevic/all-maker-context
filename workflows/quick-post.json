    {
      "parameters": {
        "jsCode": "// Reply or like on Bluesky. The target's cid and thread root come from the live post.\nconst r = $('Route').first().json;\nconst s = $('Bluesky session (engage)').first().json;\nconst post = ($json.posts || [])[0];\nif (!post) throw new Error('Bluesky post not found. It may have been deleted.');\nconst ref = { uri: post.uri, cid: post.cid };\nconst createdAt = new Date().toISOString();\nif (r.action === 'like') {\n  return [{ json: { repo: s.did, collection: 'app.bsky.feed.like', record: { $type: 'app.bsky.feed.like', subject: ref, createdAt } } }];\n}\nconst root = (post.record && post.record.reply && post.record.reply.root) || ref;\nreturn [{ json: { repo: s.did, collection: 'app.bsky.feed.post', record: {\n  $type: 'app.bsky.feed.post', text: r.bluesky.text, facets: r.bluesky.facets, createdAt, langs: ['en'],\n  reply: { root, parent: ref },\n} } }];\n"
      },
