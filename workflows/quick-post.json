      "parameters": {
        "jsCode": "// Build the Bluesky record: shortened, clickable links from Route, plus a link card when the post has a link.\nconst p = $('Route').first().json;\nconst s = $('Bluesky session').first().json;\nconst card = $('Link card').first().json;\nconst record = {\n  $type: 'app.bsky.feed.post',\n  text: p.bluesky.text,\n  createdAt: new Date().toISOString(),\n  langs: ['en'],\n  facets: p.bluesky.facets,\n};\nif (card.url) record.embed = { $type: 'app.bsky.embed.external', external: { uri: card.url, title: card.title, description: card.description } };\nreturn [{ json: { repo: s.did, collection: 'app.bsky.feed.post', record } }];\n"
      },
